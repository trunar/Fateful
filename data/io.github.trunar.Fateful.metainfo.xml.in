<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.trunar.Fateful</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Fateful</name>
  <summary>Roll four Fate dice</summary>
  <description>
    <p>Fateful is a compact Fate dice roller for GTK 4 and libadwaita. Roll four dice, see the Fate ladder result, and review recent rolls.</p>
  </description>

  <developer id="io.github.trunar">
    <name>Andrii Indyk</name>
  </developer>

  <url type="homepage">https://github.com/trunar/Fateful</url>
  <url type="vcs-browser">https://github.com/trunar/Fateful</url>
  <url type="bugtracker">https://github.com/trunar/Fateful/issues</url>

  <translation type="gettext">fateful</translation>
  <launchable type="desktop-id">io.github.trunar.Fateful.desktop</launchable>
  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#3584e4</color>
    <color type="primary" scheme_preference="dark">#78aeed</color>
  </branding>

  <releases>
    <release version="0.1.0" date="2026-10-20">
      <description translate="no">
        <p>First release of Fateful, a compact desktop roller for Fate dice.</p>
        <ul>
          <li>Roll four animated Fate dice and see the total with its ladder descriptor.</li>
          <li>Review the four most recent rolls.</li>
          <li>Choose dice colors and animation speed, and mute or unmute dice sounds.</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
